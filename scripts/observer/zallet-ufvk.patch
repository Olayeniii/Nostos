+    #[test]
+    fn nostos_orchard_decode_accepts_only_full_key_on_matching_network() {
+        use zcash_keys::keys::UnifiedSpendingKey;
+        use zcash_protocol::consensus::{MAIN_NETWORK, TEST_NETWORK};
+        let full = UnifiedSpendingKey::from_seed(&MAIN_NETWORK, &[7; 32], zip32::AccountId::ZERO)
+            .unwrap().to_unified_full_viewing_key();
+        let encoded = full.encode(&MAIN_NETWORK);
+        assert!(decode_orchard_key(&MAIN_NETWORK, &encoded).is_ok());
+        assert!(decode_orchard_key(&TEST_NETWORK, &encoded).is_err());
+        assert!(decode_orchard_key(&MAIN_NETWORK, &format!(" {encoded}")).is_err());
+        assert!(decode_orchard_key(&MAIN_NETWORK, "not-a-key").is_err());
+        let incoming = full.to_unified_incoming_viewing_key().encode(&MAIN_NETWORK);
+        assert!(decode_orchard_key(&MAIN_NETWORK, &incoming).is_err());
+        let sapling = sapling::zip32::ExtendedSpendingKey::master(&[8; 32]);
+        #[allow(deprecated)]
+        let sapling_only = UnifiedFullViewingKey::from_sapling_extended_full_viewing_key(
+            sapling.to_extended_full_viewing_key()).unwrap().encode(&MAIN_NETWORK);
+        assert!(decode_orchard_key(&MAIN_NETWORK, &sapling_only).is_err());
+    }
+
