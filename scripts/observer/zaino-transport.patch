+// Exact public-chain allowlist. This does not enable any RPC or retry a send.
+fn nostos_chain_read(method: &str) -> bool {
+    matches!(method,
+        "getinfo" | "getblockchaininfo" | "getbestblockhash" | "getblockcount"
+        | "getblockhash" | "getblock" | "getblockheader" | "getrawmempool"
+        | "getrawtransaction" | "z_gettreestate" | "z_getsubtreesbyindex"
+        | "getaddressbalance" | "getaddresstxids" | "getaddressutxos" | "getmempoolinfo"
+    )
+}
+
+#[test]
+fn nostos_timeout_policy_excludes_wallet_and_broadcast_calls() {
+    for method in ["getblock", "getrawtransaction", "z_gettreestate", "getbestblockhash"] {
+        assert!(nostos_chain_read(method));
+    }
+    for method in ["sendrawtransaction", "z_sendmany", "z_sendfromaccount",
+                   "z_importviewingkey", "walletpassphrase", "getblock ", "GETBLOCK"] {
+        assert!(!nostos_chain_read(method));
+    }
 }
 
