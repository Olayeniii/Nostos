{
  "name": "nostos",
  "version": "0.0.0",
  "private": true,
  "description": "Private refunds for shielded ZEC payments.",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@11.28.7",
  "engines": {
    "node": "^24.22.1",
    "pnpm": "^11.28.7"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "node scripts/quality/check-node.mjs && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm secret:scan",
    "clean": "node scripts/quality/clean.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "secret:scan": "node scripts/quality/secret-scan.mjs",
    "spike:setup": "tsx scripts/shielded-spike/setup-demo-wallets.ts",
    "spike:send-payment": "tsx scripts/shielded-spike/send-payment.ts",
    "spike:scan-payment": "tsx scripts/shielded-spike/scan-payment.ts",
    "spike:send-refund": "tsx scripts/shielded-spike/send-refund.ts",
    "spike:verify": "tsx scripts/shielded-spike/verify-roundtrip.ts",
    "intake:scan": "tsx scripts/payment-intake/scan.ts",
    "intake:verify": "tsx scripts/payment-intake/verify-restart.ts",
    "refund:send": "tsx scripts/refund-core/send.ts",
    "refund:verify": "tsx scripts/refund-core/verify.ts",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "24.5.2",
    "eslint": "9.39.5",
    "globals": "16.4.0",
    "prettier": "3.6.2",
    "tsx": "4.23.15",
    "typescript": "5.9.2",
    "typescript-eslint": "8.72.0",
    "vitest": "4.1.12"
  }
}
