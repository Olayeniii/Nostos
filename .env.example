NOSTOS_NETWORK=testnet
NOSTOS_LOG_LEVEL=info
NOSTOS_DATABASE_PATH=./data/nostos.sqlite

# Loopback only. Set real ports and credentials outside source control.
NOSTOS_CUSTOMER_WALLET_RPC_URL=
NOSTOS_CUSTOMER_WALLET_RPC_USER=
NOSTOS_CUSTOMER_WALLET_RPC_PASSWORD=
NOSTOS_CUSTOMER_WALLET_RPC_COOKIE_FILE=
NOSTOS_MERCHANT_WALLET_RPC_URL=
NOSTOS_MERCHANT_WALLET_RPC_USER=
NOSTOS_MERCHANT_WALLET_RPC_PASSWORD=
NOSTOS_MERCHANT_WALLET_RPC_COOKIE_FILE=

# Gate G1 spike values. Use isolated testnet funds only.
NOSTOS_PAYMENT_ZEC=0.02
NOSTOS_REFUND_ZEC=0.005
NOSTOS_ORDER_REFERENCE=demo-order-001
NOSTOS_SPIKE_STATE_PATH=./runtime/shielded-spike.json

# Generate a fresh value for each deployed environment.
NOSTOS_DATA_ENCRYPTION_KEY=

# Exact browser origins allowed to submit refunds. No Host/header inference.
NOSTOS_WEB_TRUSTED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# Separate 32-byte hex key for read-only per-payment receipt access.
# Generate privately on the VPS. Never use the merchant access code here.
NOSTOS_RECEIPT_SECRET=

# Separate merchant password, scrypt salt:hash. Configured privately on the VPS.
NOSTOS_MERCHANT_PASSWORD_HASH=

# Real merchant accounts: separate storage from legacy proof records.
NOSTOS_PRODUCT_DATABASE_PATH=/nostos-product/accounts.sqlite
NOSTOS_PRODUCT_CORE_DATABASE_PATH=/nostos-product/payments.sqlite
# Generate privately on the VPS. Keep this key with encrypted database backups.
NOSTOS_PRODUCT_DATA_KEY=
